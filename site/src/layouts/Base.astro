---
import '../styles/tokens.css';
import '../styles/global.css';
import { AUTHOR } from '../lib/site';
// Preload the two above-the-fold font files so they do not wait for the stylesheet to arrive.
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import plexSansUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Data-analysis portfolio: scheduled pipelines, dashboards with written methodology, built end to end with Claude Code.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/how-i-work/', label: 'How I work' },
  { href: '/about/', label: 'About' },
  { href: '/changelog/', label: 'Changelog' },
];
const path = Astro.url.pathname;
const isHome = path === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {AUTHOR}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSansUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="page">
      <nav class="site-nav" aria-label="Primary">
        {nav.map((n) => (
          <a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
        ))}
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle light / dark">
          <span class="theme-icon" aria-hidden="true"></span>
        </button>
      </nav>
      <div class="masthead">
        <a class="masthead__avatar" href="/" aria-hidden="true" tabindex="-1"><img src="/photos/avatar-64.jpg" srcset="/photos/avatar-64.jpg 1x, /photos/avatar-128.jpg 2x" width="64" height="64" alt="" decoding="async" /></a>
        <div>
        <p class="masthead__name">{isHome ? AUTHOR : <a href="/">{AUTHOR}</a>}</p>
        <p class="masthead__sub">Data analysis, dashboards, and the pipelines behind them</p>
        </div>
      </div>
    </header>
    <main id="main" class="page">
      <div class="tufte">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="page">
        <span>© {new Date().getUTCFullYear()} {AUTHOR} · </span>
        <a href="https://github.com/srx7703/srx7703.github.io">Source on GitHub</a>
        <span> · Built with Claude Code, Astro and Vega-Lite. Data refreshed by GitHub Actions.</span>
      </div>
    </footer>
    <script>
      const btn = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const apply = (t: string | null) => {
        if (t === 'light' || t === 'dark') root.dataset.theme = t;
        else delete root.dataset.theme;
        document.dispatchEvent(new CustomEvent('themechange'));
      };
      btn?.addEventListener('click', () => {
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', next); } catch {}
        apply(next);
      });
    </script>
  </body>
</html>
