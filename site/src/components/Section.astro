---
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---
<section id={id} class="section">
  <h2><a href={`#${id}`} class="anchor">{title}</a></h2>
  <slot />
</section>
<style>
  .section { margin: var(--s-6) 0; }
  .section h2 { font-size: var(--fs-xl); margin: 0 0 var(--s-3); }
  .anchor { color: inherit; text-decoration: none; }
  .anchor:hover { text-decoration: underline; }
</style>
