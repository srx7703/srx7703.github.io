---
/**
 * Renders a Vega-Lite spec client-side with vega-embed. Any string of the form `token:--name`
 * inside the spec is replaced at render time with the CSS custom property's computed value, so
 * chart chrome and series colours follow the light/dark theme from tokens.css.
 *
 * Optional `group`: the chart joins a dashboard group driven by <DashboardControls group=…>.
 * Its rendered view is registered in `window.__dash[group].views` (keyed by chart id), and
 * before every (re-)render the group's current control state is written into the spec's
 * matching top-level `params` values, so lazy, theme and resize re-renders keep the selection.
 *
 * Optional `titles` (needs `group`): a map from the group's control values, joined with '|' in
 * the DashboardControls `controls` order (or in `titleKeys` order when given), to the figure
 * title for that view, plus an optional `default` entry. DashboardControls rewrites the
 * enclosing figure's `.figure__title` from it on load and on every change, so the title always
 * states the finding of the view on screen. The build-time title should equal the default key's.
 *
 * Optional `titlesSrc` (with `group`): the same map, served as a same-origin JSON file instead of being inlined in the page; the
 * dashboard fetches it once, when a control first differs from its default. A spec may carry it itself, as the private keys
 * `_titlesSrc` and `_titleKeys` (removed here, never sent to the browser): then `titles` is not inlined either.
 *
 * Optional `tableId`: the id of the table that carries the same numbers. Without JavaScript the sentence under the chart then
 * links to that table and says the chart is not drawn, and the empty placeholder collapses (so does the no-op CSV button
 * and the theme toggle, which need JavaScript too). Without `tableId` the page is unchanged.
 *
 * The authored `ariaLabel` is also written into the spec's `description` before rendering, because Vega replaces the
 * container's aria-label with its own default once the chart is drawn.
 *
 * Private spec keys read here and removed before the spec reaches Vega: `_facetColumns` (panels per row of a faceted spec), and
 * `_widthInset` (pixels kept free beside a single-view spec; default 70, which suits specs that were laid out with a y axis outside
 * the width; a spec whose width already contains its axes, as with `autosize: fit-x, contains: padding`, sets a small one).
 * `_specInScript`: the spec travels in a `<script type="application/json">` next to the chart instead of in a `data-spec`
 * attribute. An attribute must escape every quote (`&quot;`, six bytes for one), which is most of the weight of a large spec; the
 * script holds it as it is. Without the key the markup is as before.
 */
interface Props {
  spec: Record<string, unknown>;
  id: string;
  height?: number;
  ariaLabel: string;
  group?: string;
  titles?: Record<string, string>;
  titleKeys?: string[];
  titlesSrc?: string;
  tableId?: string;
  tableLabel?: string;
}
const { spec: fullSpec, id, height = 300, ariaLabel, group, titles, titleKeys, titlesSrc, tableId, tableLabel } = Astro.props;
const { _titlesSrc, _titleKeys, _specInScript, ...spec } = fullSpec as Record<string, unknown> & { _titlesSrc?: string; _titleKeys?: string[]; _specInScript?: boolean };
// a `<` inside the JSON must not be able to end the script element
const specJson = JSON.stringify(spec);
const inScript = _specInScript === true ? specJson.replace(/</g, '\\u003c') : undefined;
const src = group ? (titlesSrc ?? _titlesSrc) : undefined;
const keys = titleKeys?.length ? titleKeys : _titleKeys;
const dashTitles = group && titles && !src ? JSON.stringify(titles) : undefined;
const dashKeys = group && (dashTitles || src) && keys?.length ? keys.join(' ') : undefined;
---
<div class="vega" id={id} data-spec={inScript ? undefined : specJson} data-spec-in={inScript ? `${id}-spec` : undefined} data-group={group} data-dash-group={(dashTitles || src) && group} data-dash-titles={dashTitles} data-dash-titles-src={src} data-dash-keys={dashKeys} role="img" aria-label={ariaLabel} style={`min-height:${height}px`}></div>
{inScript && <script is:inline type="application/json" id={`${id}-spec`} set:html={inScript}></script>}
{tableId ? (
  <noscript>
    <p class="muted">Charts need JavaScript, so this figure is not drawn. The same numbers are in <a href={`#${tableId}`}>{tableLabel ?? 'the table'}</a>.</p>
    <style is:inline set:html={`#${id}{min-height:0!important}button.dl,#theme-toggle{display:none}`}></style>
  </noscript>
) : (
  <noscript><p class="muted">Charts need JavaScript. The underlying numbers are in the tables and CSV downloads on this page and in the public data files.</p></noscript>
)}
<script>
  // vega-embed (~700 KB) is loaded on demand when the first chart nears the viewport.
  let embedPromise: Promise<any> | null = null;
  const loadEmbed = () => (embedPromise ??= import('vega-embed').then((m) => m.default));
  const rendered = new Set<Element>();

  const cssVar = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const isDark = () => document.documentElement.dataset.theme === 'dark'
    || (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);

  const resolve = (v: unknown): unknown => {
    if (typeof v === 'string' && v.startsWith('token:')) return cssVar(v.slice(6));
    if (Array.isArray(v)) return v.map(resolve);
    if (v && typeof v === 'object') return Object.fromEntries(Object.entries(v as Record<string, unknown>).map(([k, x]) => [k, resolve(x)]));
    return v;
  };

  const themeConfig = () => ({
    background: 'transparent',
    font: cssVar('--font-sans') || 'system-ui, sans-serif',
    axis: {
      labelColor: cssVar('--ink-2'), titleColor: cssVar('--ink-2'), gridColor: cssVar('--grid'),
      domainColor: cssVar('--border-strong'), tickColor: cssVar('--border-strong'),
      labelFontSize: 12, titleFontSize: 12, titleFontWeight: 'normal', labelPadding: 6, titlePadding: 8,
    },
    legend: { labelColor: cssVar('--ink-2'), titleColor: cssVar('--ink-2'), labelFontSize: 12, symbolSize: 80 },
    view: { stroke: null },
    text: { color: cssVar('--ink-2') },
  });

  // Explicit pixel width (not 'container'): Vega-Lite's container sizing misbehaves for band
  // scales with xOffset (renders 0 x 1030). Faceted specs size their own panels.
  const innerWidth = (el: HTMLElement) => Math.max(240, Math.floor(el.clientWidth) - 8);

  const render = async (el: HTMLElement) => {
    const embed = await loadEmbed();
    rendered.add(el);
    const text = el.dataset.spec ?? (el.dataset.specIn ? document.getElementById(el.dataset.specIn)?.textContent : null);
    const spec = resolve(JSON.parse(text || '{}')) as Record<string, any>;
    spec.config = { ...(spec.config || {}), ...themeConfig() };
    // Vega replaces the container's aria-label once it draws, so the authored text goes into the spec.
    if (el.dataset.aria) spec.description = el.dataset.aria;
    const w = el.clientWidth || el.getBoundingClientRect().width;
    const inset = Number.isFinite(Number(spec._widthInset)) && spec._widthInset != null ? Number(spec._widthInset) : 70;
    delete spec._widthInset;
    if (!spec.facet && !spec.spec) {
      spec.width = w > 0 ? Math.max(120, innerWidth(el) - inset) : 'container'; // room beside the plot; container if not laid out yet
      spec.autosize = { type: 'fit-x', contains: 'padding' };
    } else if (spec.spec && w > 0) {
      const cols = Number(spec._facetColumns) || 1;
      spec.spec.width = Math.max(96, Math.floor((innerWidth(el) - 90) / cols)); // panels shrink to fit on phones
    }
    delete spec._facetColumns;
    const group = el.dataset.group;
    const dash = group ? ((window as any).__dash ??= {})[group] ??= { state: {}, views: new Map() } : null;
    if (dash && Array.isArray(spec.params)) {
      for (const p of spec.params) if (p && !p.bind && p.name in dash.state) p.value = dash.state[p.name];
    }
    if (dash) { dash.views.get(el.id)?.finalize?.(); dash.views.delete(el.id); }
    const result = await embed(el, spec as any, { actions: false, renderer: 'svg', tooltip: { theme: isDark() ? 'dark' : 'light' } });
    if (dash) {
      dash.views.set(el.id, result.view);
      // A control may have changed while this chart was embedding: catch the view up.
      const names = new Set((spec.params || []).filter((p: any) => p && !p.bind).map((p: any) => p.name));
      let stale = false;
      for (const [k, v] of Object.entries(dash.state)) if (names.has(k) && result.view.signal(k) !== v) { result.view.signal(k, v); stale = true; }
      if (stale) await result.view.runAsync();
    }
  };

  const all = () => document.querySelectorAll<HTMLElement>('.vega');
  all().forEach((el) => { if (!el.dataset.aria) el.dataset.aria = el.getAttribute('aria-label') || ''; });
  const safeRender = (el: HTMLElement) => render(el).catch((e) => console.error('chart failed', el.id, e));
  const renderAll = () => all().forEach((el) => { if (rendered.has(el)) safeRender(el); });
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { io.unobserve(e.target); safeRender(e.target as HTMLElement); }
    }
  }, { rootMargin: '400px 0px' });
  all().forEach((el) => io.observe(el));
  document.addEventListener('themechange', renderAll);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', renderAll);
  // Re-render when a chart's box changes size: window resize, a collapsed <details> opening,
  // or the first layout after a hidden start (width 0 -> real width).
  const lastWidth = new WeakMap<Element, number>();
  const ro = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const el = entry.target as HTMLElement;
      const w = Math.round(entry.contentRect.width);
      const prev = lastWidth.get(el) ?? -1;
      if (w > 0 && Math.abs(w - prev) > 24) {
        lastWidth.set(el, w);
        if (prev !== -1 && rendered.has(el)) safeRender(el);
      }
    }
  });
  all().forEach((el) => ro.observe(el));
</script>
<style>
  .vega { width: 100%; }
</style>
