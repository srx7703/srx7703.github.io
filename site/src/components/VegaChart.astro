---
/**
 * Renders a Vega-Lite spec client-side with vega-embed. Any string of the form `token:--name`
 * inside the spec is replaced at render time with the CSS custom property's computed value, so
 * chart chrome and series colours follow the light/dark theme from tokens.css.
 */
interface Props {
  spec: Record<string, unknown>;
  id: string;
  height?: number;
  ariaLabel: string;
}
const { spec, id, height = 300, ariaLabel } = Astro.props;
---
<div class="vega" id={id} data-spec={JSON.stringify(spec)} role="img" aria-label={ariaLabel} style={`min-height:${height}px`}></div>
<noscript><p class="muted">Charts need JavaScript. The underlying numbers are in the tables and CSV downloads on this page and in the public data files.</p></noscript>
<script>
  // vega-embed (~700 KB) is loaded on demand when the first chart nears the viewport.
  let embedPromise: Promise<any> | null = null;
  const loadEmbed = () => (embedPromise ??= import('vega-embed').then((m) => m.default));
  const rendered = new Set<Element>();

  const cssVar = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const isDark = () => document.documentElement.dataset.theme === 'dark'
    || (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);

  const resolve = (v: unknown): unknown => {
    if (typeof v === 'string' && v.startsWith('token:')) return cssVar(v.slice(6));
    if (Array.isArray(v)) return v.map(resolve);
    if (v && typeof v === 'object') return Object.fromEntries(Object.entries(v as Record<string, unknown>).map(([k, x]) => [k, resolve(x)]));
    return v;
  };

  const themeConfig = () => ({
    background: 'transparent',
    font: cssVar('--font-sans') || 'system-ui, sans-serif',
    axis: {
      labelColor: cssVar('--ink-2'), titleColor: cssVar('--ink-2'), gridColor: cssVar('--grid'),
      domainColor: cssVar('--border-strong'), tickColor: cssVar('--border-strong'),
      labelFontSize: 12, titleFontSize: 12, titleFontWeight: 'normal', labelPadding: 6, titlePadding: 8,
    },
    legend: { labelColor: cssVar('--ink-2'), titleColor: cssVar('--ink-2'), labelFontSize: 12, symbolSize: 80 },
    view: { stroke: null },
    text: { color: cssVar('--ink-2') },
  });

  // Explicit pixel width (not 'container'): Vega-Lite's container sizing misbehaves for band
  // scales with xOffset (renders 0 x 1030). Faceted specs size their own panels.
  const innerWidth = (el: HTMLElement) => Math.max(240, Math.floor(el.clientWidth) - 8);

  const render = async (el: HTMLElement) => {
    const embed = await loadEmbed();
    rendered.add(el);
    const spec = resolve(JSON.parse(el.dataset.spec || '{}')) as Record<string, any>;
    spec.config = { ...(spec.config || {}), ...themeConfig() };
    const w = el.clientWidth || el.getBoundingClientRect().width;
    if (!spec.facet && !spec.spec) {
      spec.width = w > 0 ? innerWidth(el) - 70 : 'container'; // room for the y axis; container if not laid out yet
      spec.autosize = { type: 'fit-x', contains: 'padding' };
    } else if (spec.spec && w > 0) {
      const cols = Number(spec._facetColumns) || 1;
      spec.spec.width = Math.max(96, Math.floor((innerWidth(el) - 90) / cols)); // panels shrink to fit on phones
    }
    delete spec._facetColumns;
    await embed(el, spec as any, { actions: false, renderer: 'svg', tooltip: { theme: isDark() ? 'dark' : 'light' } });
  };

  const all = () => document.querySelectorAll<HTMLElement>('.vega');
  const safeRender = (el: HTMLElement) => render(el).catch((e) => console.error('chart failed', el.id, e));
  const renderAll = () => all().forEach((el) => { if (rendered.has(el)) safeRender(el); });
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { io.unobserve(e.target); safeRender(e.target as HTMLElement); }
    }
  }, { rootMargin: '400px 0px' });
  all().forEach((el) => io.observe(el));
  document.addEventListener('themechange', renderAll);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', renderAll);
  // Re-render when a chart's box changes size: window resize, a collapsed <details> opening,
  // or the first layout after a hidden start (width 0 -> real width).
  const lastWidth = new WeakMap<Element, number>();
  const ro = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const el = entry.target as HTMLElement;
      const w = Math.round(entry.contentRect.width);
      const prev = lastWidth.get(el) ?? -1;
      if (w > 0 && Math.abs(w - prev) > 24) {
        lastWidth.set(el, w);
        if (prev !== -1 && rendered.has(el)) safeRender(el);
      }
    }
  });
  all().forEach((el) => ro.observe(el));
</script>
<style>
  .vega { width: 100%; }
</style>
