---
/** One key figure in a ruled row (KpiRow): label, value, and a qualifying line. */
interface Props {
  label: string;
  value: string;
  sub?: string;
  tone?: 'neutral' | 'positive' | 'negative';
}
const { label, value, sub, tone = 'neutral' } = Astro.props;
---
<div class={`kf kf--${tone}`}>
  <dt class="kf__label">{label}</dt>
  <dd class="kf__value">{value}</dd>
  {sub && <dd class="kf__sub">{sub}</dd>}
</div>
