---
/**
 * Filter row for one dashboard group. Every <VegaChart group={group}> on the page whose spec
 * declares a top-level, unbound Vega-Lite param with a control's `name` is driven through
 * `view.signal(name, value).runAsync()`. State lives in the URL query as `?<group>.<name>=<value>`
 * (read on load, written with history.replaceState). An optional linked table (DataTable id or
 * ids) hides rows whose `data-<name>` attribute does not match the current value; a row may instead
 * carry `data-<name>-any`, a space-separated list of the values it belongs to, and is hidden when the
 * current value is not in the list; rows without either attribute are left alone.
 *
 * Selection-dependent titles: any element with `data-dash-group="<group>"` and
 * `data-dash-titles='{"<v1>|<v2>": "title", …, "default": "title"}'` gets its title rewritten on
 * load and on every change, so a figure never states a finding about a view the reader is not
 * looking at. Keys are the current control values joined with '|' in `controls` order, or in the
 * order of the space-separated control names in `data-dash-keys` when present; a missing key
 * falls back to `default`, else the title is left as built. The element itself is the title when
 * it is a heading or `.figure__title`; otherwise the `.figure__title` of its enclosing <figure>
 * (so `<VegaChart group titles={map}>` inside a ChartCard works without touching ChartCard).
 *
 * A title map may also be served as a file: an element with `data-dash-titles-src="<url>"` (and no inline map) gets the same
 * treatment, fetched once, and only when the current selection differs from the default (the default title is already in the
 * page). The file holds the same JSON object.
 *
 * Linked tables may be lazy <UrlTable>s: a table loads its rows later and announces it with a `urltable:loaded` event (detail
 * `{ id }`); the filter is applied to the rows then. After every pass this component dispatches `dash:applied` on the document
 * so a table can refresh its own count.
 *
 * Opt-in, so that other pages are unchanged:
 *  - `tableLabels` { tableId: "listings" }: for each listed table a line under the controls (a live region) and one above the
 *    table say "Showing N of M listings" as the controls change, and say so when no row is left.
 *  - `note` / slot `note`: one line under the controls, for which figure each control drives. Shown with the controls.
 *  - `noscript`: the sentence shown without JavaScript, instead of the default one.
 *
 * Controls render as a native radio <fieldset> (default for up to 4 options) or a native
 * <select>. Without JavaScript the row stays hidden and a sentence states the default view.
 *
 * Keep the script below 4 KB once built (Vite's inline limit): over it, every page that uses this component gets an extra
 * request for it instead of the inline module, which is not a change a page asked for.
 */
type Value = string | number | boolean;
interface Option { value: Value; label: string }
interface Control {
  name: string;          // Vega-Lite param / signal name, also the URL key suffix and data-<name> on table rows
  label: string;
  options: Option[];
  default: Value;
  type?: 'radio' | 'select'; // default: radio when options.length <= 4, else select
}
interface Props {
  group: string;
  controls: Control[];
  table?: string | string[];
  label?: string;        // accessible name for the whole row
  tableLabels?: Record<string, string>; // table id -> what its rows are ("listings"), for "Showing N of M listings"
  note?: string;         // one line under the controls
  noscript?: string;     // replaces the default no-JavaScript sentence
}
const { group, controls, table, label = 'Dashboard controls', tableLabels, note, noscript } = Astro.props as Props;
const tables = table == null ? [] : Array.isArray(table) ? table : [table];
const hasNote = !!note || Astro.slots.has('note');
const labelled = tableLabels && Object.keys(tableLabels).length > 0 ? tableLabels : undefined;
// the rules of the note, the status line and the line above a table: only when one of them is used
const optCss = hasNote || labelled
  ? '.dash__note,.dash__status,.dash__tablenote{margin:0 0 var(--s-3);font-family:var(--font-sans);font-size:var(--fs-sm);color:var(--ink-3);max-width:70ch}.dash__tablenote{margin:var(--s-2) 0}.dash__status a{color:inherit}'
  : '';
const uid = `dash-${group}`;
const kind = (c: Control) => c.type ?? (c.options.length <= 4 ? 'radio' : 'select');
const defaultLabel = (c: Control) => c.options.find((o) => o.value === c.default)?.label ?? String(c.default);
const config = controls.map((c) => ({ name: c.name, default: c.default, values: c.options.map((o) => o.value) }));
---
{optCss && <style is:inline set:html={optCss}></style>}
<form class="dash" id={uid} data-group={group} data-tables={tables.join(' ')} data-config={JSON.stringify(config)} data-table-labels={labelled ? JSON.stringify(labelled) : undefined} aria-label={label} aria-describedby={hasNote ? `${uid}-note` : undefined} hidden>
  {controls.map((c) => kind(c) === 'radio' ? (
    <fieldset class="dash__field" data-control={c.name}>
      <legend class="dash__label">{c.label}</legend>
      <span class="dash__options">
        {c.options.map((o, i) => (
          <label class="dash__radio">
            <input type="radio" name={`${uid}-${c.name}`} value={String(o.value)} data-index={i} checked={o.value === c.default} />
            {o.label}
          </label>
        ))}
      </span>
    </fieldset>
  ) : (
    <label class="dash__field dash__select" data-control={c.name}>
      <span class="dash__label">{c.label}</span>
      <select name={`${uid}-${c.name}`}>
        {c.options.map((o, i) => <option value={String(o.value)} data-index={i} selected={o.value === c.default}>{o.label}</option>)}
      </select>
    </label>
  ))}
</form>
{hasNote && <p class="dash__note" id={`${uid}-note`} hidden>{note}<slot name="note" /></p>}
{labelled && <p class="dash__status" id={`${uid}-status`} aria-live="polite" hidden></p>}
<noscript><p class="muted dash__nojs">{noscript ?? `The interactive controls need JavaScript; the charts below show the default view (${controls.map((c) => `${c.label}: ${defaultLabel(c)}`).join('; ')}).`}</p></noscript>
<script>
  type Value = string | number | boolean;
  interface Cfg { name: string; default: Value; values: Value[] }
  interface Dash { state: Record<string, Value>; views: Map<string, any> }

  const registry = (): Record<string, Dash> => ((window as any).__dash ??= {});

  // Title maps served as files: fetched once per URL, shared by every control row.
  const titleMaps = new Map<string, Promise<Record<string, string>>>();
  const loadTitleMap = (url: string) => {
    let p = titleMaps.get(url);
    if (!p) {
      p = fetch(url).then((r) => { if (!r.ok) throw new Error(`${r.status} ${url}`); return r.json(); });
      p.catch((e) => { console.error('title map failed to load', url, e); titleMaps.delete(url); });
      titleMaps.set(url, p);
    }
    return p;
  };

  // A lazy table announces its rows with `urltable:loaded`; the control row that owns the table filters them then.
  const tableAppliers = new Map<string, () => void>();
  document.addEventListener('urltable:loaded', (e) => {
    const id = (e as CustomEvent<{ id?: string }>).detail?.id;
    if (id) tableAppliers.get(id)?.();
  });

  document.querySelectorAll<HTMLFormElement>('form.dash').forEach((form) => {
    const group = form.dataset.group || '';
    const cfg: Cfg[] = JSON.parse(form.dataset.config || '[]');
    const dash: Dash = (registry()[group] ??= { state: {}, views: new Map() });
    const tableIds = (form.dataset.tables || '').split(' ').filter(Boolean);
    const labels: Record<string, string> = JSON.parse(form.dataset.tableLabels || '{}');
    const status = document.getElementById(`${form.id}-status`);

    // Initial state: URL query value if it is one of the options, else the default.
    const params = new URLSearchParams(location.search);
    for (const c of cfg) {
      const raw = params.get(`${group}.${c.name}`);
      const hit = raw == null ? undefined : c.values.find((v) => String(v) === raw);
      dash.state[c.name] = hit !== undefined ? hit : c.default;
    }

    const syncInputs = () => {
      for (const c of cfg) {
        const idx = c.values.findIndex((v) => v === dash.state[c.name]);
        form.querySelectorAll<HTMLInputElement | HTMLOptionElement>(`[data-control="${c.name}"] [data-index]`).forEach((el) => {
          const on = Number(el.dataset.index) === idx;
          if (el instanceof HTMLInputElement) el.checked = on; else el.selected = on;
        });
      }
    };

    const writeUrl = () => {
      const q = new URLSearchParams(location.search);
      for (const c of cfg) {
        const key = `${group}.${c.name}`;
        if (dash.state[c.name] === c.default) q.delete(key); else q.set(key, String(dash.state[c.name]));
      }
      const s = q.toString();
      history.replaceState(history.state, '', `${location.pathname}${s ? `?${s}` : ''}${location.hash}`);
    };

    const hasSignal = (view: any, name: string) => {
      try { view.signal(name); return true; } catch { return false; }
    };

    const applyCharts = (names: string[]) => {
      dash.views.forEach((view) => {
        let touched = false;
        for (const n of names) if (hasSignal(view, n)) { view.signal(n, dash.state[n]); touched = true; }
        if (touched) view.runAsync().catch((e: unknown) => console.error('dashboard update failed', group, e));
      });
    };

    // "Showing N of M <what>" for the tables that have a label: a line under the controls (a live region) and a line above the
    // table, which says so when nothing is left. The counts are of rows the controls leave in view; a table's own search box is
    // counted by the table.
    const tableNotes = new Map<string, HTMLElement>();
    const noteFor = (t: HTMLTableElement): HTMLElement => {
      let note = tableNotes.get(t.id);
      if (!note) {
        note = document.createElement('p');
        note.className = 'dash__tablenote';
        const anchor = t.closest<HTMLElement>('.urltable, .table-wrap') ?? t;
        anchor.parentElement?.insertBefore(note, anchor);
        tableNotes.set(t.id, note);
      }
      return note;
    };
    const report = () => {
      if (!status) return;
      const parts: string[] = [];
      for (const id of tableIds) {
        const noun = labels[id];
        const t = document.getElementById(id) as HTMLTableElement | null;
        if (!noun || !t?.tBodies[0]) continue;
        const rows = Array.from(t.tBodies[0].rows).filter((tr) => !tr.classList.contains('urltable__wait'));
        if (!rows.length) continue; // a lazy table that has not loaded yet
        const shown = rows.filter((tr) => !tr.classList.contains('dash-out')).length;
        const text = `${shown} of ${rows.length} ${noun}`;
        parts.push(`<a href="#${id}">${text}</a>`);
        const note = noteFor(t);
        note.textContent = shown === 0 ? `Showing ${text}: no row matches these controls. Change a control to see rows.` : `Showing ${text}, as the controls above leave them. Change a control to see more.`;
      }
      if (parts.length) {
        status.innerHTML = `Showing ${parts.join(' and ')} in the table${parts.length > 1 ? 's' : ''} below.`;
        status.hidden = false;
      }
    };

    const applyTables = () => {
      for (const id of tableIds) {
        const t = document.getElementById(id) as HTMLTableElement | null;
        Array.from(t?.tBodies[0]?.rows ?? []).forEach((tr) => {
          const out = cfg.some((c) => {
            const n = c.name.toLowerCase();
            // `data-<name>-any` lists every value a row belongs to (space-separated), for a row that is in more than
            // one view of a control, such as a listing that is both "all" and "us". Without it, `data-<name>` must
            // equal the control's value exactly.
            const any = tr.getAttribute(`data-${n}-any`);
            if (any != null) return !any.split(' ').includes(String(dash.state[c.name]));
            const a = tr.getAttribute(`data-${n}`);
            return a != null && a !== String(dash.state[c.name]);
          });
          tr.classList.toggle('dash-out', out);
        });
      }
      report();
      document.dispatchEvent(new CustomEvent('dash:applied', { detail: { group, tables: tableIds } }));
    };
    tableIds.forEach((id) => tableAppliers.set(id, applyTables));

    const titleTarget = (el: HTMLElement): HTMLElement | null =>
      el.matches('h1,h2,h3,h4,h5,h6,.figure__title') ? el
        : el.closest('figure')?.querySelector<HTMLElement>('.figure__title') ?? el.querySelector<HTMLElement>('.figure__title');

    const applyTitles = () => {
      document.querySelectorAll<HTMLElement>('[data-dash-titles],[data-dash-titles-src]').forEach((el) => {
        if (el.dataset.dashGroup !== group) return;
        const keys = (el.dataset.dashKeys || '').split(' ').filter(Boolean);
        const names = keys.length ? keys.filter((k) => k in dash.state) : cfg.map((c) => c.name);
        const key = names.map((n) => String(dash.state[n])).join('|');
        const set = (map: Record<string, string>) => {
          const title = map[key] ?? map.default;
          const target = titleTarget(el);
          if (title != null && target && target.textContent !== title) target.textContent = title;
        };
        if (el.dataset.dashTitles != null) {
          let map: Record<string, string>;
          try { map = JSON.parse(el.dataset.dashTitles || '{}'); } catch { return; }
          set(map);
          return;
        }
        const url = el.dataset.dashTitlesSrc;
        if (!url) return;
        // The page already carries the title of the default view; fetch the map only once a control leaves it.
        const atDefault = names.every((n) => dash.state[n] === cfg.find((c) => c.name === n)?.default);
        if (atDefault && !titleMaps.has(url)) return;
        loadTitleMap(url).then(set).catch(() => {});
      });
    };

    form.addEventListener('change', (e) => {
      const field = (e.target as HTMLElement).closest<HTMLElement>('[data-control]');
      const c = cfg.find((x) => x.name === field?.dataset.control);
      if (!c) return;
      const target = e.target as HTMLInputElement | HTMLSelectElement;
      const idx = target instanceof HTMLSelectElement
        ? Number(target.selectedOptions[0]?.dataset.index)
        : Number((target as HTMLInputElement).dataset.index);
      if (!(idx >= 0 && idx < c.values.length)) return;
      dash.state[c.name] = c.values[idx];
      writeUrl();
      applyCharts([c.name]);
      applyTables();
      applyTitles();
    });
    form.addEventListener('submit', (e) => e.preventDefault());

    syncInputs();
    applyCharts(cfg.map((c) => c.name)); // charts rendered before this ran
    applyTables();
    applyTitles();
    form.hidden = false;
    const noteEl = document.getElementById(`${form.id}-note`); // shown with the controls; the status line appears once a table has rows to count
    if (noteEl) noteEl.hidden = false;
  });
</script>
<style>
  .dash { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); align-items: baseline; margin: 0 0 var(--s-3); font-family: var(--font-sans); font-size: var(--fs-sm); color: var(--ink-2); }
  .dash[hidden] { display: none; }
  .dash__field { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-2); align-items: baseline; margin: 0; padding: 0; border: 0; min-width: 0; }
  .dash__label { float: left; padding: 0; color: var(--ink-3); }
  .dash__options { display: inline-flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); }
  .dash__radio { display: inline-flex; gap: 0.35em; align-items: baseline; color: var(--ink); cursor: pointer; }
  .dash__radio input { accent-color: var(--ink); margin: 0; }
  .dash__radio input:focus-visible, .dash select:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .dash select { font: inherit; font-size: var(--fs-sm); color: var(--ink); background: transparent; border: 1px dashed var(--border-strong); border-radius: 0; padding: 0.3em 0.6em; max-width: 100%; }
  .dash select option { color: var(--ink); background: var(--bg); }
  .dash__nojs { font-family: var(--font-sans); font-size: var(--fs-sm); }
  :global(tr.dash-out) { display: none; }
  /* Touch targets: a 13 px radio in a 22 px line is hard to hit with a finger. */
  @media (pointer: coarse) {
    .dash__radio { min-height: 40px; align-items: center; padding-right: 0.25rem; }
    .dash__radio input { width: 20px; height: 20px; }
    .dash select { min-height: 40px; }
  }
</style>
