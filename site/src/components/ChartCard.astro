---
/**
 * A figure: title states the finding, subtitle states the metric, unit and window (docs/CHART_RULES.md).
 * `size="full"` lets the figure run across the sidenote margin (Tufte's full-width figure).
 */
interface Props {
  title: string;
  subtitle?: string;
  size?: 'main' | 'full';
}
const { title, subtitle, size = 'main' } = Astro.props;
---
<figure class={`figure figure--${size}`}>
  <figcaption>
    <h2 class="figure__title">{title}</h2>
    {subtitle && <p class="figure__subtitle">{subtitle}</p>}
  </figcaption>
  <div class="figure__body"><slot /></div>
  <slot name="stamp" />
</figure>
