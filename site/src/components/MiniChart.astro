---
/** A 220 x 60 inline-SVG glyph of a project's data (see lib/minicharts.ts). Colours are CSS variables, so it follows the theme. */
import type { MiniSpec } from '@lib/minicharts';
interface Props { spec: MiniSpec }
const { spec } = Astro.props;
const W = 220, H = 60, P = 3;
const sx = (v: number, [lo, hi]: [number, number]) => P + ((v - lo) / (hi - lo || 1)) * (W - 2 * P);
const sy = (v: number, [lo, hi]: [number, number]) => H - P - ((v - lo) / (hi - lo || 1)) * (H - 2 * P);
const f = (n: number) => n.toFixed(1);

let body = '';
if (spec.kind === 'lines') {
  const xs = spec.series.flatMap((s) => s.points.map((p) => p[0]));
  const xd: [number, number] = [Math.min(...xs), Math.max(...xs)];
  if (spec.y[0] < 0 && spec.y[1] > 0) body += `<line x1="${P}" x2="${W - P}" y1="${f(sy(0, spec.y))}" y2="${f(sy(0, spec.y))}" stroke="var(--border-strong)" stroke-width="1" />`;
  for (const s of spec.series) {
    if (!s.points.length) continue;
    const d = s.points.map((p, i) => `${i ? 'L' : 'M'}${f(sx(p[0], xd))} ${f(sy(p[1], spec.y))}`).join(' ');
    const last = s.points[s.points.length - 1];
    body += `<path d="${d}" fill="none" stroke="var(${s.color})" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />`;
    body += `<circle cx="${f(sx(last[0], xd))}" cy="${f(sy(last[1], spec.y))}" r="2.4" fill="var(${s.color})" stroke="var(--bg)" stroke-width="1" />`;
  }
} else if (spec.kind === 'scatter') {
  if (spec.line) {
    const x0 = spec.x[0], x1 = spec.x[1];
    body += `<line x1="${f(sx(x0, spec.x))}" y1="${f(sy(spec.line.a + spec.line.b * x0, spec.y))}" x2="${f(sx(x1, spec.x))}" y2="${f(sy(spec.line.a + spec.line.b * x1, spec.y))}" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="3 3" />`;
  }
  for (const p of spec.points) body += `<circle cx="${f(sx(p.x, spec.x))}" cy="${f(sy(p.y, spec.y))}" r="2.6" fill="var(${p.hit ? '--series-a' : '--series-neutral'})" fill-opacity="0.85" />`;
} else {
  // slim bars in pairs (base, fine-tuned) so the glyph reads like the other marks, not like blocks
  const bw = 14, inner = 4, between = 22, n = spec.bars.length;
  const total = n * bw + (n / 2) * inner + (n / 2 - 1) * between;
  let x = (W - total) / 2;
  spec.bars.forEach((b, i) => {
    const y = sy(b.v, spec.y);
    body += `<rect x="${f(x)}" y="${f(y)}" width="${bw}" height="${f(H - P - y)}" fill="var(${b.color})" />`;
    x += bw + (i % 2 === 0 ? inner : between);
  });
  body += `<line x1="${P}" x2="${W - P}" y1="${H - P}" y2="${H - P}" stroke="var(--border-strong)" stroke-width="1" />`;
}
---
<svg class="mini" viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={spec.label} set:html={body} />
