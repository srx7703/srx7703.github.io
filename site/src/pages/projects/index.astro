---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import ProjectPreview from '@components/ProjectPreview.astro';
import { cardKpis } from '@lib/cardKpis';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const domains = Array.from(new Set(projects.flatMap((p) => p.data.domain))).sort();
---
<Base title="Projects">
  <h1>Projects</h1>
  <p class="lede">Live dashboards refresh on a schedule; case studies are frozen write-ups of finished work.</p>
  <div class="filters" role="group" aria-label="Filter projects">
    <span class="filters__label">Type</span>
    <button type="button" data-filter="status" data-value="" aria-pressed="true">All</button>
    <button type="button" data-filter="status" data-value="live" aria-pressed="false">Live</button>
    <button type="button" data-filter="status" data-value="case-study" aria-pressed="false">Case study</button>
    <span class="filters__label">Domain</span>
    <button type="button" data-filter="domain" data-value="" aria-pressed="true">All</button>
    {domains.map((d) => <button type="button" data-filter="domain" data-value={d} aria-pressed="false">{d}</button>)}
    <span class="filters__count" aria-live="polite"></span>
  </div>
  <div id="project-list">
    {projects.map((p) => (
      <ProjectPreview href={`/projects/${p.id}/`} title={p.data.title} summary={p.data.summary} status={p.data.status} domain={p.data.domain} started={p.data.started} kpi={cardKpis[p.id]} headingLevel="h2" />
    ))}
  </div>
  <script>
    const state: Record<string, string> = { status: '', domain: '' };
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#project-list .preview'));
    const count = document.querySelector<HTMLElement>('.filters__count');
    const apply = () => {
      let shown = 0;
      rows.forEach((c) => {
        const ok = (!state.status || c.dataset.status === state.status) && (!state.domain || (c.dataset.domain || '').split('|').includes(state.domain));
        c.hidden = !ok;
        if (ok) shown++;
      });
      if (count) count.textContent = `${shown} of ${rows.length}`;
    };
    document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((b) => {
      b.addEventListener('click', () => {
        const f = b.dataset.filter || '';
        state[f] = b.dataset.value || '';
        document.querySelectorAll<HTMLButtonElement>(`.filters button[data-filter="${f}"]`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      });
    });
    apply();
  </script>
</Base>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; margin: 0 0 var(--s-4); font-family: var(--font-sans); font-size: var(--fs-sm); }
  .filters__label { color: var(--ink-3); margin-right: var(--s-1); }
  .filters__count { margin-left: auto; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  #project-list .preview .preview__title { font-size: 1.4rem; }
</style>
