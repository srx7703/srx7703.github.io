# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# node / astro
node_modules/
site/dist/
site/.astro/
# local
.env
*.log
.DS_Store
data/tmp/
# generated by site/scripts/sync-data.mjs
site/public/data/

# SEC companyfacts payloads: EDGAR is itself a permanent public archive with stable URLs and the
# filings cannot be rewritten, so the extracted facts are kept and the 6 MB/run payload is not.
# Documented in docs/DATA_MODEL.md.
data/raw/valuation/sec/

# Yahoo payloads of the cyber track are parsed and discarded: the run reads them, the repository never
# keeps them (see LOCAL_RAW_TRACKS in pipelines/valuation/config.py).
data/raw/valuation/*_local/

# iCloud Drive syncs ~/Desktop and makes " 2" conflict copies when two processes write the same file,
# which happens constantly when several agents work in parallel. Seven of them reached a commit once.
*\ 2.*
*\ 3.*
# curators' working notes for the cyber ledger: local only (docs/cyber/CURATION.md)
data/reference/cyber/notes/

# Product-analytics exports hold pseudonymous visitor ids: analysed locally, never committed (docs/analytics/TRACKING_PLAN.md).
data/private/
